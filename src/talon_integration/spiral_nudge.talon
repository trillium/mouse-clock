tag: user.use_mouse_clock
-
# Spiral nudge commands
nudge: user.spiral_nudge()
nudge back: user.spiral_back()
nudge reset: user.spiral_reset()
nudge stop: user.spiral_stop()
spiral: user.spiral_start()
spiral reset: user.spiral_reset()
spiral stop: user.spiral_stop()
spiral cancel: user.spiral_stop()

# Visual feedback
spiral trail: user.spiral_toggle_trail()
spiral show: user.spiral_show_visual()
spiral hide: user.spiral_hide_visual()
